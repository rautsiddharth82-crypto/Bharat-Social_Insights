# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Managed providers (Timescale Cloud / Neon / Supabase) reject plain connections.
POSTGRES_SSL=false

# Which browser origin may call this API. Use "*" for local development only;
# set it to the exact deployed frontend URL in production (see DEPLOYMENT.md).
CORS_ORIGIN=http://localhost:3000

# Neo4j Graph Database (with Graph Data Science GDS)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Redis Stream & Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Platform API Credentials (Optional - Graceful seed data fallback if empty)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

YOUTUBE_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=bharat_social_insights/1.0

# Reddit via Devvit (recommended live path)
# Set to true to disable the legacy snoowrap poller once the Devvit app pushes
# posts to POST /ingest/reddit. See apps/reddit-devvit/README.md.
REDDIT_DISABLE_POLLING=false
# Optional shared secret required in the x-ingest-secret header on the webhook.
INGEST_SHARED_SECRET=

# ── ML service ───────────────────────────────────────────────────────────────
# Base URL the orchestrator uses to reach the FastAPI ML service for sentiment,
# topic, stance and forecast inference.
#   local `npm run dev`  -> http://localhost:8001
#   docker-compose       -> http://ml-service:8001 (set in the compose env block)
# If unset, config.ts defaults to http://localhost:8001.
ML_SERVICE_URL=http://localhost:8001

META_ACCESS_TOKEN=
META_PAGE_ID=

TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
